# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-worker/
# Compiled output has escaped into src/ before — tsc without an outDir drops
# .js next to the .ts, and a relative import of ../src/rbac then resolves to
# the stale copy rather than the source. dist/ is the only build output.
src/**/*.js
src/**/*.js.map
build/
.next/
*.tsbuildinfo

# Env & secrets — NEVER commit real values
.env
.env.local
.env.*.local
**/.env
!**/.env.example
.dev.vars
*.pem
serviceAccount*.json
GoogleService-Info.plist
google-services.json

# Tooling
.wrangler/
.turbo/
coverage/
.DS_Store
