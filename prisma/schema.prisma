// KukkuOne data model — one PostgreSQL DB via Prisma.
// See docs/06-Data-Model.md. Money = integer minor units + currency.
// Weights/feed = grams. Partitions (core/farmer/supplier/distributor) are logical.

generator client {
  provider = "prisma-client-js"
  // Driver adapters let the client run on a runtime that has no TCP sockets of
  // its own — a Cloudflare Worker — by handing the connection to a driver the
  // host does provide. The Node services are unaffected and keep using the
  // built-in engine.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── enums ───────────────────────────
/// The platform's six business roles. Mirrors Capability in @kukkuone/types —
/// check:enums fails the build if the two drift.
///
/// SUPPLIER split into HATCHERY and FEED_SUPPLIER (a supplier product was
/// already 'CHICK' | 'FEED', so the distinction existed a level down), and
/// DISTRIBUTOR became LIFTING_PARTNER — what it does is discover harvest-ready
/// batches, record actual weight lifted and settle, which is lifting rather
/// than trading.
enum Capability {
  FARMER
  HATCHERY
  FEED_SUPPLIER
  TRADING_PARTNER
  LIFTING_PARTNER
  CHICKEN_RETAILER
}

/// What a Trading Partner actually does, enabled one by one. Mirrors
/// TradingCapability in @kukkuone/types.
///
/// Lower-case because that is how the spec writes these keys, and re-casing
/// them would leave the stored value no longer matching the document anyone
/// checks it against. Prisma accepts the identifiers as-is.
enum TradingCapability {
  chick_trading
  feed_trading
  bird_marketing
  lifting_coordination
}

/// What is being sold. Mirrors ProductKind in @kukkuone/types, which until now
/// had no counterpart here — SupplierProduct.kind is a bare string, so the two
/// could drift without check:enums noticing. New columns use the enum; that
/// column is left alone rather than migrated in passing.
enum ProductKind {
  CHICK
  FEED
}

/// How a trading partner is standing in an input deal.
///
/// The spec insists this is recorded rather than inferred, and it is the whole
/// commercial difference between the two. As an AGENT the partner arranges a
/// purchase the farmer makes from the supplier: the supplier invoices the
/// farm, and the partner is owed a fee by whoever agreed to pay it. As a
/// RESELLER the partner bought the stock and is selling it on: the partner
/// invoices the farm, and the margin is the partner's own business.
///
/// Nothing may infer that a partner owns inventory because they arranged a
/// deal — which is exactly the mistake this column exists to prevent.
enum InputDealModel {
  AGENT
  RESELLER
}

enum InputQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum HarvestOfferStatus {
  OPEN
  CLOSED
  WITHDRAWN
}

enum HarvestResponseKind {
  INTERESTED
  DECLINED
  COUNTER
}

enum PermissionAction {
  View
  Create
  Edit
  Approve
  Dispatch
  Settle
  Report
}

enum Tenure {
  OWNED
  LEASED
}

enum RentBasis {
  PER_MONTH
  PER_SQFT
  PER_BIRD_PLACED
  PER_BATCH
}

enum GrowingModel {
  OWN
  CONTRACT
}

enum ShedStatus {
  EMPTY
  PREPARING
  READY
  OCCUPIED
  RUNNING
  HARVESTING
  CLEANING
  DISINFECTION
}

enum BatchStatus {
  PLANNED
  PLACED
  ACTIVE
  READY_FOR_HARVEST
  HARVESTING
  SOLD
  SETTLEMENT_PENDING
  SETTLED
  CLOSED
}

enum SupplierOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  ACCEPTED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  INVOICED
  SETTLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum VaccinationStatus {
  SCHEDULED
  DUE
  COMPLETED
}

enum FeedType {
  PRE_STARTER
  STARTER
  GROWER
  FINISHER
}

enum ExpenseCategory {
  CHICKS
  FEED
  MEDICINE
  VACCINATION
  LABOUR
  ELECTRICITY
  WATER
  TRANSPORT
  RENT
  LITTER
  GAS
  REPAIRS
  CLEANING
  OTHER
}

/// Who money moves to or from. A card remembers what this person charges you
/// or pays you; it is not binding on any past transaction.
/// Who a farm deals with. These are the farm's own records — a hatchery it buys
/// from is a row here whether or not that hatchery has a KukkuOne account — so
/// this is a different axis from Capability, which is what an account may do.
///
/// BUYER stays, deliberately. The spec keeps "buyer" as a transaction field
/// precisely because a lifting partner may not be the purchaser: the party who
/// collects the birds and the party who owes for them are often different
/// people, and collapsing them loses who to chase for the money.
enum PartyKind {
  HATCHERY
  FEED_SUPPLIER
  MEDICINE_SUPPLIER
  BUYER
  LIFTING_PARTNER
  TRADING_PARTNER
}

/// A buyer either pays the day's market rate or a fixed agreed rate.
enum SaleRateBasis {
  MARKET
  FIXED
}

/// Why feed stock moved: bought in, returned, or reconciled after a count.
/// The ten conditions the app watches. Each names a shed, a number and an
/// action — "mortality high" is not an alert.
enum AlertKind {
  NOT_LOGGED
  MORTALITY_SPIKE
  MORTALITY_CUMULATIVE
  FEED_LOW
  VACCINATION_DUE
  WEIGHT_BEHIND
  FCR_DRIFT
  BATCH_READY
  PAYMENT_OVERDUE
  SHED_IDLE
}

/// Feed and medicine both move the same three ways.
enum StockMovementKind {
  PURCHASE
  RETURN
  ADJUSTMENT
  /// Stock leaving for money rather than for a batch. Leftover feed sold on
  /// is farm income, not a credit against the batch it was bought for — that
  /// batch was never charged for it, because it was never issued.
  SALE
}

enum EntryDirection {
  IN
  OUT
}

/// Only the kinds that are not already a row somewhere else. A buyer payment
/// is a BuyerPayment, not an entry of kind BUYER_PAYMENT.
enum AccountEntryKind {
  OPENING
  OWNER_IN
  OWNER_OUT
  TRANSFER
  OTHER_INCOME
  OTHER_EXPENSE
}

enum InputOrderStatus {
  PLACED
  ACCEPTED
  DELIVERED
  INVOICED
  SETTLED
  CANCELLED
}

enum RevenueSource {
  BIRD
  MANURE
  LITTER
  GUNNY_BAG
  /// Leftover feed sold on rather than carried to the next batch.
  FEED_RESALE
  OTHER
}

// ─────────────────────────── core ───────────────────────────
model Organization {
  id           String              @id @default(uuid())
  name         String
  capabilities Capability[]
  /// Only meaningful alongside the TRADING_PARTNER capability, and empty is a
  /// real answer: holding the role says nothing about which of these the
  /// partner does, which is the whole reason the spec lists them separately.
  /// Nothing may infer that a partner owns inventory or buys birds merely
  /// because they arranged a deal.
  tradingCapabilities TradingCapability[]
  baseCurrency String              @default("INR")
  status       String              @default("active")
  memberships  Membership[]
  farms        Farm[]
  products     Product[]
  distributor  DistributorProfile?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
}

model User {
  id          String             @id @default(uuid())
  /// Optional since sign-in by mobile number: somebody who signs up with a
  /// phone has no email to give, and inventing one would make it a lookup key
  /// that matches nothing. Exactly one of email or phone is always present.
  email       String?            @unique
  /// E.164, including the country code. Unique because it is a sign-in key.
  phone       String?            @unique
  displayName String?
  photoUrl    String?
  status      String             @default("active")
  identities  ExternalIdentity[]
  memberships Membership[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// One OTP challenge: a code sent to a number, and what has been tried
/// against it.
///
/// The row exists because 2Factor's VERIFY takes the session id its AUTOGEN
/// returned, so unlike a provider that checks phone-plus-code the two calls
/// are not independent — something has to hold the session id in between. A
/// Worker has no memory between requests, so it is held here.
///
/// It carries the throttle counters too. Keeping the sends and the attempts on
/// the same row as the session means one read answers "may this person ask for
/// another code" and "have they burned their guesses on this one".
model OtpChallenge {
  id         String    @id @default(uuid())
  /// E.164. Indexed with createdAt because every throttle question is "what
  /// has this number done recently".
  phone      String
  /// 2Factor's session id, from the AUTOGEN response's `Details`.
  sessionId  String
  /// Verify attempts spent against this challenge. Separate from the send
  /// count on purpose: a mistyped code must not eat somebody's resends.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  /// Set when the code was accepted. A consumed challenge is never reusable.
  consumedAt DateTime?

  @@index([phone, createdAt])
}

model ExternalIdentity {
  id        String   @id @default(uuid())
  provider  String
  subject   String
  email     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model Membership {
  id              String       @id @default(uuid())
  userId          String
  orgId           String
  roleId          String
  capabilityScope Capability
  user            User         @relation(fields: [userId], references: [id])
  org             Organization @relation(fields: [orgId], references: [id])
  role            Role         @relation(fields: [roleId], references: [id])
  createdAt       DateTime     @default(now())

  @@unique([userId, orgId, roleId])
  @@index([orgId])
}

/// Which farms (manager) or sheds (worker) a member may see. No rows for a
/// user means unrestricted — that is how the owner works.
model MemberScope {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  farmId    String?
  shedId    String?
  createdAt DateTime @default(now())

  @@unique([orgId, userId, farmId, shedId])
  @@index([orgId, userId])
}

model Role {
  id          String       @id @default(uuid())
  key         String
  name        String
  capability  Capability
  orgId       String?
  permissions Permission[]
  memberships Membership[]

  @@unique([orgId, key])
}

model Permission {
  id       String           @id @default(uuid())
  roleId   String
  resource String
  action   PermissionAction
  role     Role             @relation(fields: [roleId], references: [id])

  @@unique([roleId, resource, action])
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String
  actorUserId String
  resource    String
  resourceId  String
  action      String
  before      Json?
  after       Json?
  at          DateTime @default(now())

  @@index([orgId, resource, resourceId])
}

model Notification {
  id        String    @id @default(uuid())
  orgId     String
  userId    String?
  type      String
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId, userId])
}

/// An open alert. It resolves itself when the condition clears — the shed gets
/// logged, the feed is bought, the payment lands.
model Alert {
  id          String    @id @default(uuid())
  orgId       String
  kind        AlertKind
  /// What it is about, so the condition can be re-checked and cleared.
  subjectType String
  subjectId   String
  farmId      String?
  title       String
  detail      String
  value       Float?
  /// YYYY-MM-DD: the same condition never fires twice in a day.
  dayKey      String
  readAt      DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orgId, kind, subjectId, dayKey])
  @@index([orgId, resolvedAt])
}

/// Every threshold is a setting. A farm that cannot change a number it
/// disagrees with starts ignoring the whole feature.
model AlertSetting {
  id        String    @id @default(uuid())
  orgId     String
  kind      AlertKind
  enabled   Boolean   @default(true)
  threshold Float?

  @@unique([orgId, kind])
}

/// Silenced per shed, per kind.
model AlertMute {
  id     String    @id @default(uuid())
  orgId  String
  kind   AlertKind
  shedId String

  @@unique([orgId, kind, shedId])
}

/// The breed's own performance sheet, typed once and shared by every batch of
/// that breed. Nothing is seeded: a wrong seeded table is worse than none.
model BreedStandard {
  id     String               @id @default(uuid())
  orgId  String
  breed  String
  points BreedStandardPoint[]

  @@unique([orgId, breed])
}

model BreedStandardPoint {
  id         String        @id @default(uuid())
  standardId String
  day        Int
  weightG    Int
  fcr        Float?
  standard   BreedStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([standardId, day])
}

/// What one member may see and do. Absent rows mean the role's defaults.
model MemberVisibility {
  id             String  @id @default(uuid())
  orgId          String
  userId         String
  seeCosts       Boolean @default(true)
  seeRevenue     Boolean @default(false)
  seeProfit      Boolean @default(false)
  canPlaceClose  Boolean @default(true)
  canRecordSales Boolean @default(false)
  canAddExpenses Boolean @default(true)

  @@unique([orgId, userId])
}

/// Small org-level settings that would otherwise be schema churn.
model OrgSetting {
  orgId String
  key   String
  value Json

  @@id([orgId, key])
}

// ─────────────────────────── farmer ───────────────────────────
model Farm {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  location  String?
  // Phase 1: tenure decides whether this farm carries rent into its batches.
  tenure     Tenure     @default(OWNED)
  lessorName String?
  rentAmount Int?       // minor units (paise)
  rentBasis  RentBasis?
  leaseStart DateTime?
  leaseEnd   DateTime?
  deposit    Int?       // minor units
  org       Organization @relation(fields: [orgId], references: [id])
  sheds     Shed[]
  batches   Batch[]
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([orgId])
}

model Shed {
  id        String     @id @default(uuid())
  orgId     String
  farmId    String
  code      String
  capacity  Int
  status    ShedStatus @default(EMPTY)
  tenure    Tenure     @default(OWNED)
  /// Optional, off by default: what an owned shed would fetch if rented out,
  /// so owned and leased sheds compare on the same footing.
  notionalRent Int?    // minor units per month
  farm      Farm       @relation(fields: [farmId], references: [id])
  batches   Batch[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([orgId, farmId])
}

model Batch {
  id                String                @id @default(uuid())
  orgId             String
  farmId            String
  shedId            String
  chickSupplierId   String?
  breed             String
  // Phase 1 records the model so contract batches need no migration later.
  growingModel      GrowingModel          @default(OWN)
  hatchery          String?
  chickRate         Int?                  // minor units per chick, as declared
  chickDiscount     Int?                  // minor units per chick
  placementDate     DateTime
  targetHarvestDate DateTime?
  initialBirds      Int
  mortality         Int                   @default(0)
  /// Birds killed as unfit. NOT where leftover birds go when a batch closes —
  /// counting a write-off as a cull made every closed batch read 100%
  /// mortality, which is the number the whole dashboard leans on.
  culls             Int                   @default(0)
  birdsSold         Int                   @default(0)
  /// Birds unaccounted for at close: neither sold nor recorded as dead. They
  /// bring birds-alive to zero without being blamed on welfare.
  birdsWrittenOff   Int                   @default(0)
  /// Legacy broadcast flag: NETWORK puts the batch in front of every account
  /// holding the trade capability. HarvestOffer is the addressed replacement —
  /// a farmer names who may see a lot — and this stays only so existing rows
  /// keep working while discovery is migrated.
  harvestVisibility String                @default("HIDDEN") // HIDDEN | NETWORK
  status            BatchStatus           @default(PLANNED)
  farm              Farm                  @relation(fields: [farmId], references: [id])
  shed              Shed                  @relation(fields: [shedId], references: [id])
  harvestOffers     HarvestOffer[]
  dailyLogs         DailyLog[]
  weightRecords     WeightRecord[]
  feedConsumption   FeedConsumption[]
  medicineUsage     MedicineUsage[]
  vaccinations      VaccinationSchedule[]
  expenses          Expense[]
  expenseAllocations ExpenseAllocation[]
  revenues          Revenue[]
  harvests          Harvest[]
  sales             Sale[]
  settlement        Settlement?
  closure           BatchClosure?
  purchases         Purchase[]
  createdBy         String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  @@index([orgId, status])
}

model DailyLog {
  id              String    @id @default(uuid())
  orgId           String
  batchId         String
  date            DateTime
  openingBirds    Int
  mortality       Int       @default(0)
  culls           Int       @default(0)
  closingBirds    Int
  weightSampleQty Int?
  avgWeight       Int?
  minWeight       Int?
  maxWeight       Int?
  uniformity      Int?
  feedType        FeedType?
  feedConsumed    Int?
  water           Int?
  medicineNotes   String?
  tempC           Float?
  humidity        Float?
  notes           String?
  batch           Batch     @relation(fields: [batchId], references: [id])
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([batchId, date])
  @@index([orgId])
}

model WeightRecord {
  id         String   @id @default(uuid())
  orgId      String
  batchId    String
  date       DateTime
  sampleQty  Int
  avgWeight  Int
  minWeight  Int?
  maxWeight  Int?
  uniformity Int?
  batch      Batch    @relation(fields: [batchId], references: [id])
  createdAt  DateTime @default(now())

  @@index([orgId, batchId])
}

model FeedItem {
  id          String            @id @default(uuid())
  orgId       String
  type        FeedType
  brand       String?
  bagSizeKg   Int
  inventory   FeedInventory[]
  consumption FeedConsumption[]

  @@index([orgId])
}

model FeedInventory {
  id         String   @id @default(uuid())
  orgId      String
  farmId     String?
  feedItemId String
  kind       StockMovementKind @default(PURCHASE)
  /// Required on an ADJUSTMENT: nothing is ever silently absorbed.
  reason     String?
  bags       Int      @default(0)
  kg         Int      @default(0)
  supplierId String?
  /// Cost of one kg, in minor units. Issues are costed at the weighted average.
  unitCost   Int?
  currency   String   @default("INR")
  date       DateTime @default(now())
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id])

  @@index([orgId, feedItemId])
}

model FeedConsumption {
  id         String   @id @default(uuid())
  orgId      String
  batchId    String
  feedItemId String
  date       DateTime
  bags       Int      @default(0)
  kg         Int      @default(0)
  cost       Int?
  currency   String   @default("INR")
  batch      Batch    @relation(fields: [batchId], references: [id])
  feedItem   FeedItem @relation(fields: [feedItemId], references: [id])

  @@index([orgId, batchId])
}

model MedicineItem {
  id              String              @id @default(uuid())
  orgId           String
  name            String
  /// What one unit is — bottle, sachet, litre. Stock is counted in these.
  unit            String
  /// Days after the last dose before birds may be sold. The label's figure.
  withdrawalDays  Int                 @default(0)
  usage           MedicineUsage[]
  inventory       MedicineInventory[]

  @@index([orgId])
}

/// Medicine is bought a few units at a time and drawn down by batches, exactly
/// as feed is. A purchase is cash out at the farm; the issue charges the batch.
model MedicineInventory {
  id             String            @id @default(uuid())
  orgId          String
  farmId         String?
  medicineItemId String
  kind           StockMovementKind @default(PURCHASE)
  /// Required on an ADJUSTMENT: nothing is ever silently absorbed.
  reason         String?
  qty            Int               @default(0)
  supplierId     String?
  /// Cost of one unit, in minor units. Issues are costed at the weighted average.
  unitCost       Int?
  currency       String            @default("INR")
  /// Medicine expires on a shelf; feed does not, so only this side carries it.
  expiryDate     DateTime?
  date           DateTime          @default(now())
  medicineItem   MedicineItem      @relation(fields: [medicineItemId], references: [id])

  @@index([orgId, medicineItemId])
}

model MedicineUsage {
  id             String       @id @default(uuid())
  orgId          String
  batchId        String
  medicineItemId String
  date           DateTime
  /// A five-day course is one record, not five.
  endDate        DateTime?
  withdrawalDays Int          @default(0)
  reason         String?
  qty            Int
  cost           Int?
  currency       String       @default("INR")
  notes          String?
  batch          Batch        @relation(fields: [batchId], references: [id])
  medicineItem   MedicineItem @relation(fields: [medicineItemId], references: [id])

  @@index([orgId, batchId])
}

model VaccinationSchedule {
  id            String            @id @default(uuid())
  orgId         String
  batchId       String
  vaccine       String
  scheduledDate DateTime
  completedDate DateTime?
  status        VaccinationStatus @default(SCHEDULED)
  batch         Batch             @relation(fields: [batchId], references: [id])

  @@index([orgId, batchId])
}

/// Hatchery, feed supplier or buyer. Rates here only pre-fill an entry screen —
/// every transaction stores the rate actually used on its own date.
model Party {
  id           String         @id @default(uuid())
  orgId        String
  kind         PartyKind
  name         String
  phone        String?
  place        String?
  /// Minor units: per chick (hatchery), per kg (feed supplier, buyer).
  declaredRate Int?
  /// Minor units off the declared rate. A buyer's may be a premium (negative).
  discount     Int?
  rateBasis    SaleRateBasis  @default(MARKET)
  creditDays   Int            @default(15)
  active       Boolean        @default(true)
  sales        Sale[]         @relation("SaleBuyer")
  lifted       Sale[]         @relation("SaleLifter")
  brokered     Sale[]         @relation("SaleFacilitator")
  payments     BuyerPayment[]
  /// Bills this party raised on the farm — the supplier side of the ledger.
  expenses     Expense[]
  paidOut      SupplierPayment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  revenues       Revenue[]
  accountEntries AccountEntry[]

  @@index([orgId, kind])
}

model Expense {
  accountId   String?
  id        String          @id @default(uuid())
  orgId     String
  /// Set when the cost belongs to one batch. Null for a farm cost covering a
  /// month and several batches — those are split by ExpenseAllocation.
  batchId   String?
  farmId    String?
  category  ExpenseCategory
  amount    Int
  currency  String          @default("INR")
  date      DateTime
  /// First of the month for a monthly farm cost (wages, power, rent).
  periodMonth DateTime?
  /// Whether the bill was settled as it was entered. A false here is a bill on
  /// credit: it stays outstanding and is cleared by SupplierPayment, never by
  /// flipping this flag — the flag records how the bill arrived, not its state.
  paid      Boolean         @default(true)
  /// Who the money is owed to. Absent on a cost with no counterparty, such as
  /// accrued rent or a cash sundry.
  partyId   String?
  billKey   String?
  /// Rent accrues from a lease rather than being typed by anyone.
  autoAccrued Boolean       @default(false)
  notes     String?
  batch     Batch?          @relation(fields: [batchId], references: [id])
  party     Party?          @relation(fields: [partyId], references: [id])
  allocations ExpenseAllocation[]
  settlements SupplierPaymentAllocation[]
  createdBy String
  createdAt DateTime        @default(now())

  @@index([orgId, batchId])
  @@index([orgId, partyId])
}

/// Money paid out to a supplier, the mirror of BuyerPayment. One transfer is
/// one row here however many bills it clears; what it cleared is in its
/// allocations, and anything left over sits on account against future bills.
model SupplierPayment {
  accountId   String?
  id          String   @id @default(uuid())
  orgId       String
  partyId     String
  date        DateTime
  amount      Int
  mode        String   @default("CASH")
  reference   String?
  notes       String?
  party       Party    @relation(fields: [partyId], references: [id])
  allocations SupplierPaymentAllocation[]
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([orgId, partyId])
}

/// How much of one payment settled one bill. A bill is closed when its
/// allocations reach its amount, so a part payment stays visibly part paid.
model SupplierPaymentAllocation {
  id        String          @id @default(uuid())
  orgId     String
  paymentId String
  expenseId String
  amount    Int
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expense   Expense         @relation(fields: [expenseId], references: [id])

  @@unique([paymentId, expenseId])
  @@index([orgId, expenseId])
}

/// A farm cost's share of one batch, by bird-days. A batch that ran 20 Sep to
/// 28 Oct carries eleven days of September and twenty-eight of October.
model ExpenseAllocation {
  id        String   @id @default(uuid())
  orgId     String
  expenseId String
  batchId   String
  amount    Int
  birdDays  Int      @default(0)
  manual    Boolean  @default(false)
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  batch     Batch    @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())

  @@unique([expenseId, batchId])
  @@index([orgId, batchId])
}

/// Money earned that is not a bird sale.
///
/// batchId is optional because not all of it belongs to a batch. Manure comes
/// off a particular flock and is that batch's; leftover feed sold on is the
/// farm's, because the batch it was bought for was never charged for it.
model Revenue {
  id       String        @id @default(uuid())
  orgId    String
  batchId  String?
  farmId   String?
  partyId  String?
  source   RevenueSource
  amount   Int
  currency String        @default("INR")
  date     DateTime
  notes    String?
  batch    Batch?        @relation(fields: [batchId], references: [id])
  party    Party?        @relation(fields: [partyId], references: [id])

  @@index([orgId, batchId])
}

model Harvest {
  id             String   @id @default(uuid())
  orgId          String
  batchId        String
  date           DateTime
  birdsHarvested Int
  totalWeight    Int
  batch          Batch    @relation(fields: [batchId], references: [id])

  @@index([orgId, batchId])
}

/// One lot, not the batch: birds leave in two or three lifts, to different
/// traders, at different rates.
/// One lot of birds leaving the farm.
///
/// Three parties, recorded separately because they are separately true. The
/// buyer owes the money. The lifting party turned up and took the birds, and
/// may be somebody the buyer sent. The facilitator introduced the two and is
/// owed a fee by whoever agreed to pay it. A sale where all three are the same
/// person is common and still records three references to that person rather
/// than one reference and two assumptions.
model Sale {
  id           String         @id @default(uuid())
  orgId        String
  batchId      String
  /// Who owes for these birds.
  buyerId      String?
  /// Who collected them. Often the buyer, not always — a buyer may send a
  /// lifter, and short weight is argued with whoever did the weighing.
  liftingPartyId String?
  /// The trading partner who introduced the deal, if one did.
  facilitatorId  String?
  date         DateTime       @default(now())
  qty          Int
  /// Gross live weight in grams.
  weight       Int
  /// Minor units per kg, as declared on the day.
  declaredRate Int?
  /// Minor units per kg off (or, negative, above) the declared rate.
  discount     Int?
  /// The rate actually used = declared − discount. Stored, never recomputed.
  rate         Int
  amount       Int
  currency     String         @default("INR")
  vehicle      String?
  slipKey      String?
  notes        String?
  batch        Batch          @relation(fields: [batchId], references: [id])
  buyer        Party?         @relation("SaleBuyer", fields: [buyerId], references: [id])
  liftingParty Party?         @relation("SaleLifter", fields: [liftingPartyId], references: [id])
  facilitator  Party?         @relation("SaleFacilitator", fields: [facilitatorId], references: [id])
  settlements  BuyerPaymentAllocation[]
  createdBy    String?
  createdAt    DateTime       @default(now())

  @@index([orgId, batchId])
}

/// Money in from a buyer. Separate from the sale, because a trader pays part on
/// the day and the rest next week.
/// Money taken in from a buyer. One receipt is one row here however many lots
/// it clears; what it cleared is in its allocations, and anything left over
/// sits on account against the buyer's next lift.
model BuyerPayment {
  accountId   String?
  id          String   @id @default(uuid())
  orgId       String
  partyId     String
  date        DateTime
  amount      Int
  mode        String   @default("CASH")
  reference   String?
  notes       String?
  party       Party    @relation(fields: [partyId], references: [id])
  allocations BuyerPaymentAllocation[]
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([orgId, partyId])
}

/// How much of one receipt settled one lot. The mirror of
/// SupplierPaymentAllocation: a lot is closed when its allocations reach its
/// amount, so a part payment stays visibly part paid.
model BuyerPaymentAllocation {
  id        String       @id @default(uuid())
  orgId     String
  paymentId String
  saleId    String
  amount    Int
  payment   BuyerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale      Sale         @relation(fields: [saleId], references: [id])

  @@unique([paymentId, saleId])
  @@index([orgId, saleId])
}

model Settlement {
  id        String        @id @default(uuid())
  orgId     String
  batchId   String        @unique
  payable   Int
  paid      Int           @default(0)
  balance   Int
  status    PaymentStatus @default(PENDING)
  date      DateTime?
  reference String?
  currency  String        @default("INR")
  batch     Batch         @relation(fields: [batchId], references: [id])
}

model BatchClosure {
  id             String   @id @default(uuid())
  orgId          String
  batchId        String   @unique
  closedAt       DateTime @default(now())
  summaryMetrics Json
  closedBy       String
  batch          Batch    @relation(fields: [batchId], references: [id])
}

// ─────────────────────────── supplier ───────────────────────────
model Product {
  id            String       @id @default(uuid())
  orgId         String
  kind          String // 'CHICK' | 'FEED'
  breed         String?
  age           Int?
  pricePerChick Int?
  feedType      FeedType?
  brand         String?
  bagSize       Int?
  pricePerBag   Int?
  qty           Int          @default(0)
  active        Boolean      @default(true)
  currency      String       @default("INR")
  org           Organization @relation(fields: [orgId], references: [id])
  inventory     Inventory[]
  orderLines    OrderLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId])
}

model Inventory {
  id        String  @id @default(uuid())
  orgId     String
  productId String
  onHand    Int     @default(0)
  reserved  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orgId, productId])
}

/// An order the farm has placed for inputs.
///
/// Who `orgId` points at depends on how the deal was struck, and that is the
/// commercial truth rather than a convenience. Under a reseller quote the
/// trading partner IS the seller and the order is against them. Under an agent
/// quote the supplier sells and the partner only arranged it, so the order is
/// against the supplier and the partner is recorded separately as the
/// facilitator with the fee they are owed.
///
/// Reading a facilitator as a seller, or a seller as a facilitator, is the
/// mistake the spec spends a paragraph warning about.
model SupplierOrder {
  id         String              @id @default(uuid())
  orgId      String // the seller: the supplier, or the partner when reselling
  buyerOrgId String // farmer org
  /// The quote this came from, when it came from one.
  ///
  /// Unique, which is what makes "one accepted quote, one order" a guarantee
  /// the database keeps rather than something the application remembers. Two
  /// acceptances racing cannot produce two orders.
  sourceQuoteId String?          @unique
  /// How the deal was struck, snapshotted. The quote can be read for this, but
  /// an order should not have to fetch another row to know who it is against.
  dealModel  InputDealModel?
  /// The trading partner who arranged it. Only set under AGENT — under
  /// RESELLER the partner is the seller and is already `orgId`.
  facilitatorOrgId String?
  /// Minor units owed to the facilitator. Separate from the order's total,
  /// which is what the seller is owed: adding them would invoice one party for
  /// the other's money.
  facilitationFee Int             @default(0)
  status     SupplierOrderStatus @default(DRAFT)
  subtotal   Int                 @default(0)
  tax        Int                 @default(0)
  discount   Int                 @default(0)
  total      Int                 @default(0)
  currency   String              @default("INR")
  lines      OrderLine[]
  dispatches Dispatch[]
  invoice    Invoice?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([orgId, status])
  @@index([buyerOrgId])
}

model OrderLine {
  id         String        @id @default(uuid())
  orderId    String
  /// The catalogue item, when the order was placed from a catalogue. A line
  /// from an accepted quote has none: the partner quoted a quantity and a
  /// price, not a product, and inventing a catalogue row to hold it would put
  /// something in a supplier's catalogue that they never listed.
  productId  String?
  /// What was ordered, in words, when there is no product to name it.
  description String?
  qty        Int
  unitRate   Int
  lineAmount Int
  subtotal   Int
  tax        Int           @default(0)
  discount   Int           @default(0)
  total      Int
  order      SupplierOrder @relation(fields: [orderId], references: [id])
  product    Product?      @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Dispatch {
  id       String        @id @default(uuid())
  orderId  String
  number   String
  vehicle  String?
  driver   String?
  dateTime DateTime
  status   String
  order    SupplierOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Invoice {
  id       String        @id @default(uuid())
  orderId  String        @unique
  amount   Int
  paid     Int           @default(0)
  balance  Int
  status   PaymentStatus @default(PENDING)
  order    SupplierOrder @relation(fields: [orderId], references: [id])
  payments Payment[]
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Int
  method    String?
  reference String?
  date      DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ─────────────────────────── distributor ───────────────────────────
model DistributorProfile {
  id            String               @id @default(uuid())
  orgId         String               @unique
  operatingArea String?
  org           Organization         @relation(fields: [orgId], references: [id])
  relationships FarmerRelationship[]
  purchases     Purchase[]
}

model FarmerRelationship {
  id                   String             @id @default(uuid())
  distributorProfileId String
  farmerOrgId          String
  status               String             @default("active")
  distributorProfile   DistributorProfile @relation(fields: [distributorProfileId], references: [id])

  @@unique([distributorProfileId, farmerOrgId])
}

model Purchase {
  id                   String                 @id @default(uuid())
  orgId                String // distributor org
  distributorProfileId String
  batchId              String
  farmerOrgId          String
  expectedQty          Int
  expectedWeight       Int
  rate                 Int
  amount               Int
  currency             String                 @default("INR")
  distributorProfile   DistributorProfile     @relation(fields: [distributorProfileId], references: [id])
  batch                Batch                  @relation(fields: [batchId], references: [id])
  actuals              PurchaseActuals?
  settlement           DistributorSettlement?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([orgId])
  @@index([batchId])
}

model PurchaseActuals {
  id          String   @id @default(uuid())
  purchaseId  String   @unique
  actualBirds Int
  rejects     Int      @default(0)
  liveWeight  Int
  rate        Int
  gross       Int
  adjustments Int      @default(0)
  final       Int
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
}

model DistributorSettlement {
  id         String        @id @default(uuid())
  purchaseId String        @unique
  payable    Int
  paid       Int           @default(0)
  balance    Int
  date       DateTime?
  reference  String?
  status     PaymentStatus @default(PENDING)
  currency   String        @default("INR")
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
}

/// A farmer offering a harvest-ready batch to named lifting partners.
///
/// This is a grant, not a publication. A role does not entitle anybody to see
/// another participant's farms or batches; what a recipient may see is what a
/// farmer chose to tell them about one lot, and nothing else. The batch's
/// mortality, medicine, costs and margin are not reachable from here, by
/// design and not by omission.
///
/// The numbers are a snapshot taken when the offer was made rather than a join
/// onto the batch. Two reasons. A live join would be exactly the window this is
/// meant not to be — a recipient would watch the flock change. And an offer is
/// a statement somebody made on a day: birds die between the offer and the
/// lift, and what was offered has to stay readable afterwards, or an argument
/// about short weight has nothing to refer to.
model HarvestOffer {
  id            String              @id @default(uuid())
  /// The farmer's organisation. Recipients are in HarvestOfferRecipient.
  orgId         String
  batchId       String
  /// As offered, on offeredAt. Deliberately not live.
  birds         Int
  /// Grams. Null when the batch has no weight record yet.
  avgWeightGrams Int?
  readyDate     DateTime
  /// Minor units per kg the farmer is asking, if they said one.
  askRate       Int?
  /// Snapshot too: a recipient is told which farm and where, and gains no
  /// route to the farm record itself.
  farmName      String
  place         String?
  breed         String?
  notes         String?
  status        HarvestOfferStatus  @default(OPEN)
  offeredAt     DateTime            @default(now())
  closedAt      DateTime?
  createdBy     String?
  batch         Batch               @relation(fields: [batchId], references: [id])
  recipients    HarvestOfferRecipient[]
  responses     HarvestOfferResponse[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([orgId, status])
  @@index([batchId])
}

/// Who a farmer showed an offer to. The grant itself: an organisation sees an
/// offer if and only if it has a row here.
model HarvestOfferRecipient {
  id       String       @id @default(uuid())
  offerId  String
  /// The recipient organisation — a lifting partner, or a trading partner
  /// asked to market the lot.
  orgId    String
  /// The farmer's own contact record for them, when they have one. Kept so the
  /// farmer's books and the platform account can be reconciled later.
  partyId  String?
  /// The trading partner who passed this on, when the farmer did not address
  /// them directly. Null means the farmer chose them.
  ///
  /// Recorded rather than inferred because the chain is the point: a farmer
  /// who offered a lot to one broker should be able to see it reached four
  /// lifters and which broker sent it there. It is also what makes a forward
  /// auditable, which the spec asks for on anything touching price, quantity,
  /// pickup or settlement.
  viaOrgId String?
  seenAt   DateTime?
  offer    HarvestOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([offerId, orgId])
  @@index([orgId])
}

/// A recipient's answer. Interest, a decline, or a counter with its own terms.
model HarvestOfferResponse {
  id          String              @id @default(uuid())
  offerId     String
  /// The responding organisation.
  orgId       String
  kind        HarvestResponseKind
  /// A counter states its own terms; interest may restate them or not.
  birds       Int?
  rate        Int?
  pickupDate  DateTime?
  notes       String?
  respondedBy String?
  offer       HarvestOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())

  @@index([offerId])
  @@index([orgId])
}

/// A trading partner quoting a farmer for chicks or feed.
///
/// The quote states the model up front, because a farmer accepting it is
/// agreeing to a different arrangement in each case: under AGENT they will owe
/// the supplier and the partner separately, under RESELLER they will owe the
/// partner alone. Settlement responsibility has to be clear before acceptance,
/// not discovered at the invoice.
model InputQuote {
  id            String           @id @default(uuid())
  /// The trading partner making the quote.
  orgId         String
  /// The farm being quoted.
  farmerOrgId   String
  kind          ProductKind
  model         InputDealModel
  /// What is being quoted, in the unit the kind is sold by: chicks by the
  /// bird, feed by the bag.
  qty           Int
  unit          String
  /// Minor units. Under AGENT this is the supplier's price, which the farm
  /// will pay the supplier. Under RESELLER it is the partner's own price and
  /// the only figure the farm pays.
  unitPrice     Int
  /// The partner's fee, per unit, in minor units. Only meaningful under AGENT:
  /// a reseller's margin is inside unitPrice and is not the farm's business,
  /// and stating it as a separate charge would misrepresent the deal.
  feePerUnit    Int?
  /// Who the stock actually comes from. Required in spirit under AGENT — the
  /// farm is buying from them and has to know who — and optional under
  /// RESELLER, where the partner is the seller.
  supplierOrgId String?
  currency      String           @default("INR")
  deliveryBy    DateTime?
  validUntil    DateTime?
  terms         String?
  notes         String?
  status        InputQuoteStatus @default(SENT)
  respondedAt   DateTime?
  createdBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgId, status])
  @@index([farmerOrgId, status])
}

// ─────────────────────────── money accounts ───────────────────────────

/// What kind of thing an account is — a bank, a cash box, a UPI wallet, a loan.
///
/// A table rather than an enum because a farm's own vocabulary is the point:
/// one owner keeps "Bank" and "Cash", another wants "Union Bank", "GPay" and
/// "Hand loan". The seeded rows are marked system so a farm can rename them
/// but cannot leave itself with nothing to classify an account as.
model AccountType {
  id         String    @id @default(uuid())
  orgId      String
  name       String
  system     Boolean   @default(false)
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  accounts   Account[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([orgId, name])
  @@index([orgId])
}

/// Where the farm's money actually sits.
///
/// One account covers most farms and is what a new org gets: every cost goes
/// out of it, every receipt comes into it, and the owner tops it up when it
/// runs short. Accounts nest so a farm that keeps separate books per location,
/// or splits one bank account by purpose, can say so without a second system.
///
/// Only a leaf account holds entries. A master's balance is the sum of its
/// children, and it has none of its own — the rule that stops the same rupee
/// being counted once on the sub and again on the master.
///
/// This is deliberately not the batch ledger. The account answers "can I pay
/// for the next load of feed"; batch costing answers "did this shed make
/// money". Feed bought today is cash out now and a batch cost later, when it
/// is issued, so the two never reconcile and are not meant to.
model Account {
  id             String         @id @default(uuid())
  orgId          String
  name           String
  typeId         String?
  parentId       String?
  /// Null means the account serves every farm, which is the default and what
  /// most farms want. Set it only to ring-fence one location's money.
  farmId         String?
  isDefault      Boolean        @default(false)
  openingBalance Int            @default(0)
  openedOn       DateTime?
  currency       String         @default("INR")
  archivedAt     DateTime?
  type           AccountType?   @relation(fields: [typeId], references: [id])
  parent         Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children       Account[]      @relation("AccountTree")
  entries        AccountEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orgId])
  @@index([orgId, parentId])
}

/// One movement of money into or out of an account.
///
/// Only movements that nothing else already records get a row here: the
/// opening balance, money the owner puts in or takes out, transfers between
/// accounts, and income that is not a bird sale. Buyer and supplier payments
/// are deliberately NOT copied in — they carry an accountId and are read where
/// they already live, so there is one record of each rupee and no reconciling.
model AccountEntry {
  id         String           @id @default(uuid())
  orgId      String
  accountId  String
  date       DateTime         @default(now())
  direction  EntryDirection
  kind       AccountEntryKind
  amount     Int
  partyId    String?
  /// Pairs the two legs of a transfer so neither can be read on its own.
  transferId String?
  notes      String?
  account    Account          @relation(fields: [accountId], references: [id])
  party      Party?           @relation(fields: [partyId], references: [id])
  createdBy  String?
  createdAt  DateTime         @default(now())

  @@index([orgId, accountId, date])
}

// ───────────────────── the trading partner relationship ─────────────────────

/// The farm's trading partner — who they call for chicks, feed and lifting.
///
/// A partnership exists before any deal does, which is why it cannot be
/// derived from past orders the way FarmerRelationship is. A farm that has
/// just signed up has a partner and no history.
///
/// Several are allowed because a farm may genuinely deal with more than one,
/// but most have exactly one and the apps are built for that.
model Partnership {
  id           String    @id @default(uuid())
  farmerOrgId  String
  partnerOrgId String
  status       String    @default("active")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([farmerOrgId, partnerOrgId])
  @@index([partnerOrgId, status])
  @@index([farmerOrgId, status])
}

/// The published price for day-old chicks, one rate for the day.
///
/// The trade works off a single market rate, and hatcheries differ only on the
/// discount they will give a trading partner. So the farm sees one price
/// whoever it picks, and the partner's margin is the discount — which is why
/// this is published platform-wide rather than quoted per hatchery.
model ChickRate {
  id            String   @id @default(uuid())
  /// The day it applies to, at midnight UTC.
  onDate        DateTime @unique
  paisePerChick Int
  publishedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// An order a farm places on its trading partner.
///
/// This replaces the phone call and keeps its shape: the farm asks, the
/// partner confirms what it can actually do, the load arrives, and the invoice
/// follows what arrived. There is no quote step — the farm orders and the
/// partner accepts, because that is what already happens.
model InputOrder {
  id            String           @id @default(uuid())
  /// The trading partner who fulfils it, and owns this row.
  orgId         String
  farmerOrgId   String
  kind          ProductKind

  /// Chicks: the farm picks a hatchery, on reliability rather than price.
  /// Held as a name as well as an id because hatcheries are not onboarded yet
  /// and the choice still has to be recorded.
  hatcheryOrgId String?
  hatcheryName  String?

  /// Feed: what was asked for. The partner sources it; the farm names no mill.
  feedType      String?
  brand         String?
  bagSizeKg     Int?

  /// Chicks or bags, as the farm asked for them.
  qty           Int
  needBy        DateTime?
  notes         String?

  /// What the farm pays per unit. For chicks this is the published rate held
  /// at acceptance, so a later rate change cannot silently reprice an order
  /// somebody already agreed to.
  unitPrice     Int?

  /// What the partner paid per unit, after the discount it negotiated. Never
  /// shown to the farm — the difference is the partner's margin, and keeping
  /// it private is the whole commercial basis of the relationship.
  costPrice     Int?

  /// Which batch it is for, when the farm knows. Chicks ordered before a batch
  /// is placed have none yet.
  batchId       String?

  status        InputOrderStatus @default(PLACED)
  delivery      InputDelivery?
  createdBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgId, status])
  @@index([farmerOrgId, status])
}

/// What actually arrived, and what the partner decided to bill for.
///
/// The invoice follows the count, never the order. Chicks are counted off the
/// lorry and some are dead or weak; feed is billed as delivered, not as asked
/// for. Both are the same rule.
///
/// [billable] is the partner's own call, recorded rather than computed: dead
/// and weak birds may be charged, not charged, or replaced on the next load,
/// and which of those happens is a commercial decision between two businesses
/// that this system must not make for them.
model InputDelivery {
  id          String     @id @default(uuid())
  orderId     String     @unique
  deliveredOn DateTime
  /// Chicks counted on arrival, or bags off the lorry.
  received    Int
  dead        Int        @default(0)
  weak        Int        @default(0)
  /// Units the farm is charged for.
  billable    Int
  /// Units the partner agreed to send on the next load instead of charging.
  replacing   Int        @default(0)
  note        String?
  order       InputOrder @relation(fields: [orderId], references: [id])
  recordedBy  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// What a trading partner takes, per trade.
///
/// Never shown to a farm. Chicks earn their margin from the hatchery discount
/// instead, so a rate here is mostly for feed and lifting — but both shapes
/// are allowed because partners price differently and the spec leaves the
/// choice to them.
///
/// A row with no farmerOrgId is the partner's default for everyone; one with
/// it overrides that for a single farm.
model CommissionRate {
  id          String   @id @default(uuid())
  orgId       String
  kind        String
  farmerOrgId String?
  /// A flat amount per unit, in paise.
  perUnit     Int?
  /// Or a percentage, in basis points. Exactly one of the two is set.
  basisPoints Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, kind, farmerOrgId])
}

/// A lifter telling its partners how many birds it wants.
///
/// The other half of the lifting match: a farm says a batch is ready, a lifter
/// says it needs birds, and the partner puts the two together. Without this
/// the partner is guessing at demand.
model LiftingRequirement {
  id        String    @id @default(uuid())
  orgId     String
  birds     Int
  wantBy    DateTime?
  place     String?
  notes     String?
  status    String    @default("open")
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orgId, status])
}
